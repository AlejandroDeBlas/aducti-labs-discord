# Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/aducti_labs_discord

# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PRICE_PRO_ID=price_your_pro_price_id_here
STRIPE_PRICE_FOUNDER_ID=price_your_founder_price_id_here

# Security
SESSION_SECRET=a_random_32_character_hex_secret_for_cookies_and_state
